/**
 * Cloudflare Workers config. Read only by `wrangler` / OpenNext; the Vercel
 * build ignores it. See docs/adr-cloudflare-deployment.md.
 *
 * Deploy:
 *   pnpm cf:deploy
 *
 * The database is reached through a Hyperdrive binding named HYPERDRIVE
 * (see src/db/client.ts). Create it once with:
 *   npx wrangler hyperdrive create token-ledger \
 *     --connection-string="<direct Neon connection string>"
 * then paste the returned id below.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "token-ledger",
  "main": "custom-worker.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Public, browser-safe values. NEXT_PUBLIC_REOWN_PROJECT_ID enables the
  // WalletConnect/Reown modal; without it an installed wallet can still sign.
  // Safe to commit (it is exposed to the browser by design).
  "vars": {
    "NEXT_PUBLIC_REOWN_PROJECT_ID": "840841f806a3e3d48403f5a51478e358",
    // Absolute base for links in emails. Must be the production domain so a
    // verification or reset link never depends on the request host.
    "APP_URL": "https://app.tokenledger.win"
  },
  // NOTE: do not set `limits.cpu_ms` here while this account is on the Workers
  // Free plan. The Cloudflare API rejects the deploy outright on Free with
  // error 100328 ("CPU limits are not supported for the Free plan"), it does not
  // ignore the setting. Raising the ceiling is a Workers Paid action; until then
  // per-request CPU must fit the Free budget (see #232 / #233 and
  // docs/adr-cloudflare-deployment.md).
  // Scheduled passes, run by the custom worker's `scheduled` handler (OpenNext's
  // generated worker exports only `fetch`, so a cron trigger needs the wrapper in
  // custom-worker.ts). The free plan permits daily crons; use finer schedules on a
  // paid plan. "0 3 * * *" runs both the sync and the indexer; any other tick runs
  // the indexer (idempotent and bounded).
  "triggers": {
    "crons": ["0 3 * * *", "0 9 * * *"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "da7618b3f8db4940a4ec76191c9d2ad1"
    }
  ]
}

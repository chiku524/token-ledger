# Postgres connection string. The dashboard renders example books without this.
# Adapters are stubs: do not put chain, exchange, custodian, Xero, or QuickBooks secrets here.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/token_ledger

# Required for password sessions. At least 32 characters.
# Generate one with: openssl rand -base64 32
# Demo role preview does not use this, and demo preview cannot run when DATABASE_URL is set or in production.
AUTH_SECRET=

# First owner. Used only by `pnpm auth:bootstrap` after migrate and seed. Not a public signup.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_PASSWORD=

# Optional. A private Solana RPC endpoint (Helius, QuickNode, Chainstack, and so on).
# Unset uses the free, keyless public cluster. Must be https:// with no embedded credentials.
# The reader is read-only and never signs, so no signing key belongs here.
SOLANA_RPC_URL=

# Optional. An Alchemy API key unlocks EVM ERC-20 balances and transfers for
# Ethereum and Polygon. Unset falls back to the keyless public RPC for native
# balances only. Read-only; no signing key is involved.
ALCHEMY_API_KEY=

# Optional per-chain EVM RPC override. Unset uses Alchemy (if the key is set)
# or the keyless public RPC. Must be https:// with no embedded credentials.
# EVM_RPC_URL_ETHEREUM=
# EVM_RPC_URL_POLYGON=

# Optional. A self-hosted Esplora instance or Blockstream's public instance.
# Unset uses the keyless mempool.space API. Must be https:// with no embedded
# credentials. The reader is read-only and never signs.
BITCOIN_ESPLORA_URL=

# Optional. A Sui GraphQL endpoint. Unset uses the keyless public endpoint
# (https://graphql.mainnet.sui.io/graphql). https:// only, no credentials.
SUI_RPC_URL=

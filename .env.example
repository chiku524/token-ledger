# Postgres connection string. The dashboard renders example books without this.
# Chain readers are keyless. Exchange connectors store an encrypted read-only
# credential in the database; the encryption key is below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/token_ledger

# Required for password sessions. At least 32 characters.
# Generate one with: openssl rand -base64 32
# Demo role preview does not use this, and demo preview cannot run when DATABASE_URL is set or in production.
AUTH_SECRET=

# Required to store exchange credentials. At least 32 characters, server-only.
# Derives the AES-256-GCM key that seals secrets at rest. Never sent to the browser.
# Generate one with: openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=

# Optional. Bearer token for the scheduled sync route (/api/cron/sync). When set,
# only a caller that presents it can trigger a pass; Vercel Cron sends CRON_SECRET
# automatically. At least 16 characters. Generate one with: openssl rand -base64 24
CRON_SECRET=

# Required to accept signed source webhooks (/api/webhooks/source). At least 32
# characters, server-only. A per-source signing secret is derived from it, so a
# source never shares this value. Generate one with: openssl rand -base64 32
WEBHOOK_SIGNING_SECRET=
# Optional. The receiver URL `pnpm webhook:send` posts to.
# WEBHOOK_URL=http://localhost:3000/api/webhooks/source

# Optional. Transactional email (invites, password reset, email verification).
# Unset means email is not sent: invites fall back to an on-screen link and the
# reset/verify flows log that nothing was sent. Set all of these to send.
RESEND_API_KEY=
EMAIL_FROM=onboarding@tokenledger.win
EMAIL_FROM_NAME=Token Ledger
# support@tokenledger.win is the public contact address, used in the UI.
# The absolute base URL used to build links in emails. Set this to the real
# domain in production; unset falls back to the request host (fine for previews).
APP_URL=https://app.tokenledger.win

# Optional. Coinbase, Bybit, and Gemini OAuth, used by the Connect modal. When
# unset, those exchanges fall back to a read-only API key (and the modal opens
# on the API key tab). Register the callback
# {origin}/api/connect/exchange/callback with each exchange. Scopes stay read-only.
# Coinbase OAuth app: https://www.coinbase.com/settings/api (OAuth2 applications)
# Gemini apps are created at https://exchange.gemini.com/settings/api
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=
BYBIT_OAUTH_CLIENT_ID=
BYBIT_OAUTH_CLIENT_SECRET=
GEMINI_CLIENT_ID=
GEMINI_CLIENT_SECRET=

# Exchange read-only API keys, used by `pnpm exchange:verify`. In the app a
# credential is entered by the user and stored sealed. Never enable trade or
# withdraw on any of these.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
GATE_API_KEY=
GATE_API_SECRET=
BACKPACK_API_KEY=
BACKPACK_API_SECRET=

# Custodians, used by `pnpm custodian:verify`; in the app, entered by the user
# and stored sealed. Read-only.
# BitGo: a view-only access token.
BITGO_ACCESS_TOKEN=
# Optional. Test env: https://app.bitgo-test.com
# BITGO_BASE_URL=
# Fireblocks: a Viewer API user and its RSA private key (multi-line PEM).
FIREBLOCKS_API_KEY=
FIREBLOCKS_SECRET_KEY=
# Optional. Sandbox base URL for a sandbox workspace.
# FIREBLOCKS_BASE_URL=https://sandbox-api.fireblocks.io/v1

# First owner. Used only by `pnpm auth:bootstrap` after migrate and seed. Not a public signup.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_PASSWORD=

# Optional. A comma-separated allowlist of emails granted the platform-admin
# role: a cross-organization view of every organization and every user, at
# /dashboard/platform. Separate from any organization role — an org owner/admin
# does NOT get it. Server-only. Unset means the platform panel is absent.
# PLATFORM_ADMIN_EMAILS=you@example.com

# Optional. Public Reown / WalletConnect project id. When empty, WalletConnect stays off
# and an installed wallet can still sign. This id is safe to expose to the browser.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Optional. A private Solana RPC endpoint (Helius, QuickNode, Chainstack, and so on).
# Unset uses the free, keyless public cluster. Must be https:// with no embedded credentials.
# The reader is read-only and never signs, so no signing key belongs here.
SOLANA_RPC_URL=

# Optional. An Alchemy API key unlocks EVM ERC-20 balances and transfers for
# Ethereum and Polygon. Unset falls back to the keyless public RPC for native
# balances only. Read-only; no signing key is involved.
ALCHEMY_API_KEY=

# Optional per-chain EVM RPC override. Unset uses Alchemy (if the key is set)
# or the keyless public RPC. Must be https:// with no embedded credentials.
# EVM_RPC_URL_ETHEREUM=
# EVM_RPC_URL_POLYGON=

# Optional. A self-hosted Esplora instance or Blockstream's public instance.
# Unset uses the keyless mempool.space API. Must be https:// with no embedded
# credentials. The reader is read-only and never signs.
BITCOIN_ESPLORA_URL=

# Optional. A Sui GraphQL endpoint. Unset uses the keyless public endpoint
# (https://graphql.mainnet.sui.io/graphql). https:// only, no credentials.
SUI_RPC_URL=

# Optional. Token Ledger Solana contracts (Service Balance + Accounts Payable).
# All four are required together; unset means the contract features are off and
# the read-only product is unaffected. The app resolves these from the server —
# never from user input. Devnet IDs are in contracts/DEPLOYMENTS.md. The programs
# are money-moving and are not mainnet-ready; see docs/adr-solana-contracts.md.
# SOLANA_CONTRACTS_CLUSTER=devnet
# SERVICE_BALANCE_PROGRAM_ID=GgYegKVx47vYApyQijG6g4k2pAGGJ6ub9DUhKUE4gZYo
# TREASURY_PAYABLES_PROGRAM_ID=5k5vSj1LWFLZ6doBfdwyYnxHKTpt1ot4SmBroby6ZqRi
# USDC_MINT=
# Optional. Legacy SPL Token program. Defaults to the canonical program.
# SPL_TOKEN_PROGRAM_ID=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
# Optional. The merchant admin address whose PDA is the Service Balance merchant
# config. Billing pages (plan, vault, activate) resolve the merchant from it. Set
# it only when the merchant admin key is under your control. Unset means no
# merchant-side billing actions are offered.
# MERCHANT_ADMIN_ADDRESS=
# Optional. The merchant's fixed USDC destination token account, for display.
# MERCHANT_DESTINATION_TOKEN_ACCOUNT=

# Optional. AI assistant. Unset AI_PROVIDER means the chat assistant is off and
# the rest of the app is unaffected. One provider interface covers all of these;
# pick one and set its key. Server-only: a key is never sent to the browser.
# See docs/adr-ai-assistant.md and docs/ai-chatbot.md.
# AI_PROVIDER=ollama            # ollama | anthropic | openai | huggingface | openrouter | cloudflare | openai-compatible
# AI_MODEL=                     # defaults per provider (e.g. gpt-4o-mini, claude-3-5-sonnet-latest, llama3.1)
# AI_TEMPERATURE=               # 0..2
# AI_MAX_TOKENS=
# AI_BASE_URL=                  # override the endpoint; https for hosted, http allowed for local
# AI_API_KEY=                   # generic key; a provider-specific key below wins
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# HUGGINGFACE_API_KEY=
# OPENROUTER_API_KEY=
# AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free   # a free OpenRouter model that calls tools

# Cloudflare Workers AI. Set AI_PROVIDER=cloudflare; the base URL is derived
# from CLOUDFLARE_ACCOUNT_ID. The default model runs on the Workers Free plan and
# emits tool calls; paid-only models (e.g. kimi) are rejected on Free.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8

# NOTE: an owner or admin can also switch provider/model per organization from
# the assistant panel (header) without a redeploy, choosing among the providers
# whose keys are set above. AI_PROVIDER/AI_MODEL are the deployment defaults.

# Optional. Retrieval (RAG) over chat message history. Unset AI_EMBEDDING_PROVIDER
# means the assistant runs without long-term memory; the app is unaffected.
# AI_EMBEDDING_PROVIDER=ollama  # ollama | openai | huggingface | openai-compatible
# AI_EMBEDDING_MODEL=           # defaults per provider
# AI_EMBEDDING_DIMENSIONS=      # defaults per provider (768 ollama, 1536 openai, 384 huggingface)
# AI_EMBEDDING_BASE_URL=
# AI_EMBEDDING_API_KEY=

# Optional. Assistant voice (text-to-speech via ElevenLabs). Unset means the
# Speak control is not offered and the assistant is unaffected. Server-only: the
# key is never sent to the browser; the app's /api/speech route calls ElevenLabs.
# On a free ElevenLabs plan, library voices are rejected over the API, so the
# defaults are premade voices that work on the free tier.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB   # Adam (premade, free-tier safe)
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

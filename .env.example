# Postgres connection string. The dashboard renders example books without this.
# Adapters are stubs: do not put chain, exchange, custodian, Xero, or QuickBooks secrets here.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/token_ledger

# Required for password sessions. At least 32 characters.
# Generate one with: openssl rand -base64 32
# Demo role preview does not use this, and demo preview cannot run when DATABASE_URL is set or in production.
AUTH_SECRET=

# First owner. Used only by `pnpm auth:bootstrap` after migrate and seed. Not a public signup.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_PASSWORD=

# Keep the image small and secrets out of it.
node_modules
.next
.git
.github
.vercel
.open-next
.wrangler

# The Solana contracts workspace is a separate project, unrelated to the app
# image. Keep it out of the build context entirely.
contracts

# Never bake environment or local scratch into the image.
.env
.env.*
!.env.example
*.pem
*.tsbuildinfo

# Docs and editor noise are not needed at runtime.
docs
*.md
.DS_Store
